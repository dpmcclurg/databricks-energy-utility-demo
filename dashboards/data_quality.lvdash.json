                  "datasetName": "ds_kpi",
                  "fields": [
                    {
                      "name": "records_checked",
                      "expression": "`records_checked`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "records_checked",
                  "displayName": "Records checked",
                  "format": {
                    "type": "number",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 0
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Records checked"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 3
