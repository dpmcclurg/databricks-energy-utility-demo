{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Headline checks",
      "queryLines": [
        "WITH v AS (SELECT batch, MAX(rows_checked) AS checked FROM gold_dq_summary WHERE target = 'daily_volume' GROUP BY batch) ",
        "SELECT (SELECT SUM(checked) FROM v) AS records_checked, ",
        "(SELECT SUM(rows_failed) FROM gold_dq_summary WHERE action = 'drop' AND target = 'daily_volume') AS rows_quarantined, ",
        "(SELECT SUM(rows_failed) FROM gold_dq_summary WHERE action = 'warn') AS rows_flagged, ",
        "(SELECT COUNT_IF(status = 'BALANCED') FROM gold_reconciliation) AS extracts_balanced "
      ]
    },
    {
      "name": "ds_rules",
      "displayName": "Rule results",
      "queryLines": [
        "SELECT s.rule_name, s.target, s.action, s.batch, s.rows_checked, s.rows_failed, s.pass_rate, r.constraint_sql, r.description, r.owner ",
        "FROM gold_dq_summary s JOIN dq_rules r ON s.rule_name = r.rule_name ORDER BY s.batch, s.rule_name"
      ]
    },
    {
      "name": "ds_recon",
      "displayName": "Reconciliation",
      "queryLines": [
        "SELECT batch, control_events, bronze_events, control_sum_volume, bronze_sum_volume, status FROM gold_reconciliation ORDER BY batch"
      ]
    },
    {
      "name": "ds_quarantine",
      "displayName": "Quarantine",
      "queryLines": [
        "SELECT _batch AS batch, region_id, gas_day, volume, read_status, array_join(failed_rules, ', ') AS failed_rules ",
        "FROM cgu_core.quarantine_daily_volume ORDER BY gas_day"
      ]
    }
  ],
  "pages": [
    {
      "name": "dq",
      "displayName": "Data quality",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# Gas volume data quality\n"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "subtitle",
            "multilineTextboxSpec": {
              "lines": [
                "Every record from the gas measurement system is checked against rules FP&A owns in `cgu_fpa.dq_rules`. Failing volume records are quarantined, estimated reads are flagged, weather records outside physical limits are dropped, and every extract reconciles to the source's control totals."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "kpi-checked",
